# Local development only. Replace the values below before real deployment.
HOSPITAL_ENV=development
HOSPITAL_DB_PATH=hospital.sqlite3
HOSPITAL_SEED_DEMO=true
HOSPITAL_SERVICE_TOKEN=EXAMPLE_HOSPITAL_SERVICE_TOKEN
HOSPITAL_ADMIN_TOKEN=EXAMPLE_HOSPITAL_ADMIN_TOKEN
HOSPITAL_DEV_VERIFICATION_TOKEN=EXAMPLE_HOSPITAL_DEV_VERIFICATION_TOKEN

# Gemini low-latency provider
HOSPITAL_LOW_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# High-reasoning model remains a local mock until configured separately.
HOSPITAL_HIGH_PROVIDER=mock

# ElevenLabs receives the text to be spoken. Use demo data only in this setup.
HOSPITAL_TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
HOSPITAL_ALLOW_TTS_MEDICAL_DATA=true

# Azure Speech STT (the audio is sent to Microsoft after the pre-call notice).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Local municipality intake: use separate strong values for each token.
MUNICIPAL_INTAKE_URL=http://127.0.0.1:8767
MUNICIPAL_INTAKE_TOKEN=
MUNICIPAL_STAFF_TOKEN=
